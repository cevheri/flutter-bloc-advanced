# Points a dev build at the local Keycloak demo in tool/oidc-demo/docker-compose.yml.
# Use with: --dart-define-from-file=tool/oidc-demo/oidc-demo.env, and run web on --web-port 8081.
AUTH_PROVIDER=oidc
OIDC_ISSUER=http://localhost:8080/realms/flutter-bloc-advance
OIDC_CLIENT_ID=flutter-bloc-advance
OIDC_ROLE_CLAIM=realm_access.roles
OIDC_ADMIN_ROLES=admin
OIDC_USER_ROLES=user
