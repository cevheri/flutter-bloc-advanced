# Values for the hosted demo at https://cevheri.github.io/flutter-bloc-advanced/. This file is not published.
# web/ and lib/infrastructure/config/template_config.dart keep the __KEY__ placeholders for template users. The GitHub
# Pages job builds the app with --dart-define-from-file pointing here, which gives the Dart code the value of each KEY
# it reads, and before the upload replaces each __KEY__ in build/web with the value of its KEY line here
# (scripts/fill_web_placeholders.sh). A value is used as is, so one that contains " < > & \ | #, starts with ' or `,
# or starts or ends with a space fails the job instead of being escaped or read differently by the two.
APP_NAME=Flutter BLoC Advance Template
APP_SHORT_NAME=BLoC Advance
APP_DESCRIPTION=Production-ready Flutter BLoC template with clean architecture, authentication, role-based access, responsive design system, and multi-platform support.
WEB_BASE_URL=https://cevheri.github.io/flutter-bloc-advanced/
WEB_BASE_PATH=/flutter-bloc-advanced/
GITHUB_REPO_URL=https://github.com/cevheri/flutter-bloc-advanced
DOCS_URL=https://dartpilot.github.io
SPONSOR_URL=https://github.com/sponsors/cevheri
SECURITY_CONTACT=cevheribozoglan@gmail.com
AUTHOR_NAME=cevheri
AUTHOR_URL=https://github.com/cevheri
AUTHOR_LOCATION=Turkey
