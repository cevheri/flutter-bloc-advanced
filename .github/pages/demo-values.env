# Values for the hosted demo at https://cevheri.github.io/flutter-bloc-advanced/. This file is not published.
# web/ keeps the __KEY__ placeholders for template users. Before the upload, the GitHub Pages job replaces each one in
# build/web with the value of its KEY line here (scripts/fill_web_placeholders.sh). A value is used as is, so one
# containing " < > & \ | fails the job instead of being escaped.
APP_NAME=Flutter BLoC Advance Template
APP_SHORT_NAME=BLoC Advance
APP_DESCRIPTION=Production-ready Flutter BLoC template with clean architecture, authentication, role-based access, responsive design system, and multi-platform support.
WEB_BASE_URL=https://cevheri.github.io/flutter-bloc-advanced/
AUTHOR_NAME=cevheri
AUTHOR_URL=https://github.com/cevheri
AUTHOR_LOCATION=Turkey
